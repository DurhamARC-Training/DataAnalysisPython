# twocolumn.mplstyle - Two-column spanning figure dimensions and layout
# Use with colors.mplstyle and publication.mplstyle for complete styling
# plt.style.use(['colors', 'publication', 'twocolumn'])

# Wide figure size to span both columns (typical full width ~7 inches)
figure.figsize   : 7.16, 3

# Margins optimized for wide format
figure.subplot.left   : 0.10
figure.subplot.bottom : 0.15
figure.subplot.right  : 0.95
figure.subplot.top    : 0.85

# Standard tick sizing for wide format
xtick.major.size : 4
ytick.major.size : 4
xtick.minor.size : 2
ytick.minor.size : 2

# Legend positioning optimized for wide plots
legend.loc           : best
legend.frameon       : False
legend.numpoints     : 1
