# Color cycle based on Paul Tol's vibrant qualitative color scheme, also cycle markers
axes.prop_cycle : cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'F0E442', '56B4E9']) + cycler('marker', ['o', 's', '^', 'd', '*', 'X'])

# Figure background
figure.facecolor : white
axes.facecolor   : white

# Grid styling
axes.grid        : True
axes.axisbelow   : True  # Ensures grid lines appear behind bars/glyphs
grid.color       : E0E0E0
grid.linestyle   : -
grid.linewidth   : 0.5
grid.alpha       : 0.7
